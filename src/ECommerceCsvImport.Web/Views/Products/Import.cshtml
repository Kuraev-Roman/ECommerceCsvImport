@model ImportViewModel
@{
    ViewData["Title"] = "Импорт товаров";
}

<h1 class="mb-3">Импорт товаров</h1>

<form method="post" enctype="multipart/form-data" asp-controller="Products" asp-action="Import">
    <div class="card mb-3 shadow-sm">
        <div class="card-header">Способ 1: Загрузка файла через браузер</div>
        <div class="card-body">
            <input type="file" id="file" name="file" class="form-control" accept=".csv,text/csv" />
        </div>
    </div>

    <div class="card mb-3 shadow-sm">
        <div class="card-header">Способ 2: Указание полного пути к файлу</div>
        <div class="card-body">
            <input type="text" id="filePath" name="filePath" class="form-control"
                   value="@Model.FilePath" placeholder="Например: /csv/sample_products.csv" />
            <div class="form-text">Используется, только если файл не выбран.</div>
        </div>
    </div>

    <button type="submit" class="btn btn-success">Импортировать товары</button>
    <a asp-action="Index" class="btn btn-primary">Вернуться к каталогу</a>
</form>

@if (Model.Result != null)
{
    <h2 class="mt-4">Результат импорта</h2>
    <table class="table table-bordered">
        <thead>
            <tr><th>Показатель</th><th>Значение</th></tr>
        </thead>
        <tbody>
            <tr><td>Всего строк</td><td>@Model.Result.TotalRows</td></tr>
            <tr><td>Успешно импортировано</td><td>@Model.Result.ImportedCount</td></tr>
            <tr><td>Ошибки</td><td>@Model.Result.ErrorCount</td></tr>
        </tbody>
    </table>

    @if (Model.Result.Errors.Count > 0)
    {
        <h3>Список ошибок</h3>
        <table class="table table-bordered">
            <thead>
                <tr><th>Строка</th><th>Описание ошибки</th></tr>
            </thead>
            <tbody>
                @foreach (var error in Model.Result.Errors)
                {
                    <tr><td>@error.RowNumber</td><td>@error.Message</td></tr>
                }
            </tbody>
        </table>
    }

    <a asp-action="Index" class="btn btn-success">Перейти к каталогу товаров</a>
}
